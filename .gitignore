# =====================================================================
# FoodXpress for WooCommerce — .gitignore
# Last updated: 1.2.1
# =====================================================================

# Release archives (built locally; wp.org carries the shipped zip)
routemile-woocommerce.*.zip

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Editors / IDE
.idea/
.vscode/          # see "AI tool config" below — also a top-level IDE folder
*.swp
*.swo
*~
.*.swp
.*.swo
nbproject/
*.sublime-project
*.sublime-workspace

# AI tool config (regenerated by host editors — never commit)
# Note: AGENTS.md is the multi-tool project-context file (OpenCode, Codex,
# Cursor, Aider, Devin, Gemini CLI all read it) and is COMMITTED.
# Per-tool files (CLAUDE.md, .cursorrules, .github/copilot-instructions.md)
# are still ignored — they're tool-specific and would clutter the repo.
.agent/
.agents/
.claude/
.cline/
.codex/
.cursor/
.gemini/
.kiro/
.mimosa/
.cursorrules
CLAUDE.md
.github/copilot-instructions.md

# PHP / Composer / WordPress plugin dev
vendor/
composer.lock
.phpunit.result.cache
.phpunit-watcher.yml
phpunit.xml
phpunit.xml.dist
phpcs.xml
phpcs.xml.dist
phpstan.neon
phpstan.neon.dist
psalm.xml
psalm.xml.dist
*.phar

# Logs
*.log
logs/
error_log
debug.log

# Build artifacts / Node (future use)
node_modules/
dist/
build/
.cache/
.parcel-cache/
.next/
.nuxt/
.vite/

# Local dev / test artifacts
testsprite_tests/
testsprite_*.json
test-results/
playwright-report/
playwright/.cache/
.playwright-mcp/
# Browser binaries are per-machine; contributors run `npx playwright install`.
# package.json + package-lock.json ARE committed so the harness is reproducible.
# QA screenshots (audit-*.png, my-account-*.png, order-*.png, agent-pwa-*.png, etc.)
# are session artifacts — keep the repo clean.
audit-*.png
audit-*.jpg
agent-pwa-*.png
customer-tracking-*.png
my-account-*.png
my-account-*.jpg
myaccount-*.png
orders-*.png
order-*.png
ma-*.png

# Coverage
coverage/
*.coverage
*.cover

# Local env / secrets (defense in depth)
.env
.env.local
.env.*.local
*.pem
*.key
config-local.php

# Misc
*.bak
*.orig
*.tmp
*.swp
.mimosa/
# ZCode agent session artifacts
.zcode/
